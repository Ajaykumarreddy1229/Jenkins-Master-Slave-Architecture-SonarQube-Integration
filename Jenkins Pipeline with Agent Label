A Jenkins Pipeline can specify which agent should execute the pipeline.

Example:

pipeline {
    agent {
        label 'slave1'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'YOUR_REPOSITORY_URL'
            }
        }

        stage('Compile') {
            steps {
                sh 'mvn compile'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Artifact') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Deployment') {
            steps {
                echo 'Deployment stage'
            }
        }
    }
}
